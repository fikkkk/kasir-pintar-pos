# ============================================
# Kasir Pintar POS - Backend Environment Config
# Salin file ini menjadi .env dan sesuaikan
# ============================================

# Server
PORT=5000
NODE_ENV=development

# CORS Origin (pisahkan dengan koma jika lebih dari satu saat deploy)
# Contoh: https://kasir-pintar.vercel.app
CORS_ORIGIN=http://localhost:5173

# Database MySQL (XAMPP Default / Cloud MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kasir_pintar
# Ubah ke true jika menggunakan Cloud MySQL yang mewajibkan SSL (seperti Aiven)
DB_SSL=false

# JWT Secret (ganti dengan random string yang kuat saat produksi)
JWT_SECRET=kasirpintar_secret_key_2026_sangat_rahasia
JWT_EXPIRES_IN=24h
